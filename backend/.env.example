# Base URL of your Flux GPU server (no trailing slash).
# IMPORTANT: This is NOT http://127.0.0.1:5000 if that port runs your old VTON lab UI.
# Copy the URL from your working Desktop/VTON flux_client.py or GCP VM.
FLUX_BASE_URL=http://YOUR_FLUX_GPU_HOST:5000

# Optional: Flask bind port (default 8081)
# PORT=8081