{
  "containers": {
    "vton-api": {
      "image": ":vton.vton-backend.2",
      "ports": {
        "8080": "HTTP"
      },
      "environment": {
        "FLUX_BASE_URL": "http://35.224.54.129:5000",
        "CORS_ORIGINS": "https://ecommerce-webpage-seven.vercel.app,http://localhost:5000,http://127.0.0.1:5000,http://localhost:8080"
      }
    }
  },
  "publicEndpoint": {
    "containerName": "vton-api",
    "containerPort": 8080,
    "healthCheck": {
      "healthyThreshold": 2,
      "unhealthyThreshold": 2,
      "timeoutSeconds": 5,
      "intervalSeconds": 10,
      "path": "/health",
      "successCodes": "200-499"
    }
  }
}
